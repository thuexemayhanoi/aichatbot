    },
    {
      "id": "EV",
      "icon": "⚡"
    },
    {
      "id": "SAFE",
      "icon": "🛡️"
    },
    {
      "id": "LOCAL",
      "icon": "📍"
    }
  ],
  "search": {
    "label": "Tìm Bài",
    "icon": "🔎",
    "url": "/blog/"
  },
  "services": [
    {
      "label": "Địa Chỉ",
      "icon": "📍",
