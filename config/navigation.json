    },
    {
      "label": "Bản Đồ",
      "icon": "🗺️",
      "ref": "map"
    }
  ],
  "footer_groups": [
    {
      "brand": true,
      "items": [
        {
          "ref": "home"
        },
        {
          "ref": "agent"
        },
        {
          "group": "cm"
        },
        {
          "group": "pages"
        }
      ]
    },
    {
      "group": "cm",
      "hubs": true
    },
    {
      "group": "dv",
      "row": "secondary"
    },
    {
      "group": "pl",
      "row": "secondary"
    }
  ],
  "drawer": {
    "note": "Trang Web lists the config/site-pages.json pages without a group; Pháp Lý lists the pages with \"group\": \"legal\" (same registry, same order); Cẩm Nang resolves hubs > canonical categories > non-empty subtopics from data/blog/taxonomy.json and its url is the blog home; Dịch Vụ has verified contact actions. Agent chat keeps its reset control.",
    "theme": {
      "icon": "🌗",
      "label": "Chủ đề"
    },
    "groups": [
      {
        "id": "pages",
        "label": "Trang Web",
        "icon": "🗂️",
        "children": [
          {
            "set": "pages"
          }
        ]
      },
      {
        "id": "cm",
        "label": "Cẩm nang",
        "url": "/blog/",
        "icon": "📚",
        "children": [
          {
            "set": "hubs"
          },
          {
            "ref": "search"
          }
        ]
      },
      {
        "id": "dv",
        "label": "Dịch Vụ",
        "icon": "🛵",
        "children": [
          {
            "set": "contact-actions"
          }
        ]
      },
      {
        "id": "pl",
        "label": "Pháp Lý",
        "icon": "🔒",
        "children": [
          {
            "set": "legal"
          }
        ]
      }
    ]
  },
  "chat_extras": {
    "note": "Chat-homepage-only utility appended AFTER the core drawer: a divider + the reset action. Never rendered on content pages.",
    "divider": true,
    "reset": {
      "label": "Xóa chat",
      "icon": "🧹"
    }
  },
  "hub_labels": {
    "C-APP": "Công Cụ",
    "C-RENT": "Phương Tiện",
    "C-EXPLORE": "Khám Phá"
  },
