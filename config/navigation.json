      "icon": "🌗",
      "label": "Chủ đề"
    },
    "groups": [
      {
        "id": "pages",
        "label": "Trang Web",
        "icon": "🗂️",
        "children": [
          {
            "set": "pages"
          }
        ]
      },
      {
        "id": "cm",
        "label": "Cẩm nang",
        "icon": "📚",
        "children": [
          {
            "set": "hubs"
          },
          {
            "ref": "search"
          }
        ]
      },
      {
        "id": "dv",
        "label": "Dịch Vụ",
        "icon": "🛵",
        "children": [
          {
            "set": "contact-actions"
          }
        ]
      },
      {
        "id": "pl",
        "label": "Pháp Lý",
        "icon": "🔒",
        "children": [
          {
            "set": "legal"
          }
        ]
      }
    ]
